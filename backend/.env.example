# =============================================
# TableFlow Backend — Environment Variables
# =============================================
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development
BASE_DOMAIN=tableflow.in

# Database (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=tableflow

# JWT
JWT_SECRET=your-jwt-secret-change-this
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-this

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="TableFlow <noreply@tableflow.in>"

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Platform
PLATFORM_ADMIN_EMAIL=admin@shyaratech.com
FRONTEND_URL=http://localhost:5173
